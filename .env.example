# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ── Auth.js ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Required in production: set to your deployed application URL
NEXTAUTH_URL="https://your-domain.com"

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Admin seed credentials (used only by prisma/seed.ts) ──────────────────────
# Change these immediately after first deployment
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# ── Stripe (Phase 10) ─────────────────────────────────────────────────────────
# Never expose STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET to the browser
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Resend (Phase 11) ─────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@your-domain.com"
# Business email for admin notifications
BUSINESS_EMAIL="your@business-email.com"

# ── Cron ──────────────────────────────────────────────────────────────────────
# Secret token for /api/cron/* endpoints.
# On Vercel: automatically generated per deployment — do NOT set manually.
# In local dev: set any value here to test the cron endpoint manually.
CRON_SECRET=""
