# ── Database ───────────────────────────────────────────────────────────────────
# REQUIRED. PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ── Auth.js ────────────────────────────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# REQUIRED in production. Set to your deployed Vercel URL (e.g. https://pherall.vercel.app).
# Not needed in local development — Next.js detects localhost automatically.
NEXTAUTH_URL="https://your-domain.com"

# ── Application ────────────────────────────────────────────────────────────────
# REQUIRED in production. Used to build manage-booking links in emails.
# Must match your deployed URL exactly (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Admin seed credentials (used only by prisma/seed.ts) ──────────────────────
# REQUIRED only during initial setup / seeding. Change after first deploy.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# ── Stripe ─────────────────────────────────────────────────────────────────────
# OPTIONAL. App runs without these; payments are disabled until configured.
# Set these in Admin → Settings → Payments (stored in DB) or here as fallback.
# Never expose STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET to the browser.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Obtain from Stripe Dashboard → Webhooks → your endpoint → Signing secret.
# Required for Stripe webhook signature verification.
STRIPE_WEBHOOK_SECRET=""

# ── Resend (email delivery) ────────────────────────────────────────────────────
# OPTIONAL. App runs without these; notification emails are skipped and logged
# as FAILED with reason "RESEND_API_KEY not configured".
# Set in Admin → Settings → Notifications or here as fallback.
RESEND_API_KEY=""
# Must be a verified sender domain in your Resend account.
EMAIL_FROM="noreply@your-domain.com"
# Business email for admin notifications (informational — not yet actively used).
BUSINESS_EMAIL="your@business-email.com"

# ── Cron ───────────────────────────────────────────────────────────────────────
# On Vercel: automatically injected per deployment — do NOT set manually.
#   Vercel automatically sends `Authorization: Bearer <CRON_SECRET>` to cron routes.
# In local development: set any non-empty value to call the cron endpoint manually:
#   curl -H "Authorization: Bearer <value>" http://localhost:3000/api/cron/send-reminders
# If missing: cron endpoint returns 500 and refuses to execute (safe default).
CRON_SECRET=""
